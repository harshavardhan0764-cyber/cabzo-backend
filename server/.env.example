# ==============================================================================
# CabPro Backend — Environment Variables Configuration Template
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# ==============================================================================

# ─── Server Configuration ─────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# ─── Database Client & PostgreSQL Configuration ──────────────────────────────
# Supported: postgres (recommended) or mysql
DB_CLIENT=postgres

# PostgreSQL Connection Settings
PG_HOST=localhost
PG_PORT=5432
PG_USER=postgres
PG_PASSWORD=your_actual_postgres_password
PG_DATABASE=cabpro_db
# Or use full URI:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/cabpro_db

# ─── JWT Authentication Secret Keys ──────────────────────────────────────────
# Replace with secure 64-character random strings in production
JWT_SECRET=cabpro_super_secure_jwt_secret_key_change_me_in_prod_9876543210
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=cabpro_super_secure_refresh_secret_key_1234567890
JWT_REFRESH_EXPIRES_IN=30d

# ─── OTP Security Settings ───────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=30

# ─── MSG91 SMS OTP Provider (Target Country: India) ───────────────────────────
# Required for real SMS delivery to Indian (+91) mobile numbers.
# 1. Sign up / login at https://msg91.com
# 2. Get your Authkey from: Dashboard -> Authkey
# 3. Create and approve an SMS OTP Template from: OTP -> Templates (use variable ##OTP##)
# 4. Get your DLT Approved Sender ID from: SMS -> Sender Id (e.g. CABPRO)
MSG91_AUTH_KEY=YOUR_REAL_MSG91_AUTH_KEY
MSG91_TEMPLATE_ID=YOUR_APPROVED_TEMPLATE_ID
MSG91_SENDER_ID=YOUR_SENDER_ID
MSG91_OTP_LENGTH=6
MSG91_OTP_EXPIRY=5

# ─── CORS Allowed Origin ─────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Optional: Email Notification (Nodemailer) ───────────────────────────────
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@cabbazar.com

# ─── Optional: Payment Gateway (Razorpay) ────────────────────────────────────
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ─── Firebase Admin SDK (Phone OTP Verification) ───────────────────────────
# Place serviceAccountKey.json in the server/ directory or specify absolute path
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
# Alternative direct credentials:
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

